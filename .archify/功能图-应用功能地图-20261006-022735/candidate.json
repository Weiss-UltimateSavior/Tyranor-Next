  "cards": [
    {
      "dot": "cyan",
      "title": "页面骨架",
      "items": [
        "四 Tab 常驻组合：首页（默认 / 网页）、游戏、引擎、设置",
        "八类二级页面（设置 / 封面 / 补丁 / 存档 / 拆封包等）统一经 AppScreenActivity + AppScreenScaffold 宿主",
        "平板 / 大窗口自动切换侧栏导航，导航样式三档全局生效"
      ]
    },
    {
      "dot": "emerald",
      "title": "跨域能力",
      "items": [
        "三语言（zh / ja / en）由检查工具强制键值一致，禁止源码硬编码 CJK",
        "外观风格两档玻璃 + 导航玻璃两档为全局视觉能力，作用于所有页面",
        "封面抓取与后台更新在任务管理器 / WorkManager 中持续，不阻塞页面"
      ]
    },
    {
      "dot": "amber",
      "title": "外置语义",
      "items": [
        "PC 游戏手动入库经外置 Winlator 启动；安卓游戏按包名直接跳转",
        "外置 APK 模块（Ren'Py / RPGM）与模拟器（PPSSPP / Eden）只做安装探测与 Intent 跳转",
        "主 App 不接管外置运行时的存档与设置，仅在 UI 提供跳转入口"
      ]
    }
  ]
}
