  "cards": [
    {
      "dot": "cyan",
      "title": "引擎识别优先级（前几级）",
      "items": [
        "Siglus：Gameexe.dat + Scene.pck；UK2：UK2.CFG 或 MES 头",
        "RealLive / AVG32：Gameexe.ini + SEEN.TXT 的 PACL / TOC 头分类",
        "FVP：根目录 .hcb / .bch + 资源包；KRKR：.xp3 / startup.tjs",
        "命中即停止下钻，其子目录视为引擎资源；UNKNOWN 兜底入库"
      ]
    },
    {
      "dot": "emerald",
      "title": "合并与写入语义",
      "items": [
        "手动添加的 PC / 安卓游戏不参与扫描，重扫时原样保留",
        "旧条目的封面 / vndbId / 启动文件等元数据保留，仅更新扫描字段",
        "落库经单线程 FIFO 写队列，成功后防抖 1.5s 写旧 prefs 作回滚镜像"
      ]
    },
    {
      "dot": "amber",
      "title": "扫描附带产物",
      "items": [
        "本地封面（cover.jpg / icon.png 等）命中即写入 coverUri",
        "Ren'Py 版本建议与 RPGM 子运行时写入 engine_detection_cache",
        "ROM 文件（.iso / .pbp / .nsp 等）一 ROM 一条，launchTarget 为文件名"
      ]
    }
  ]
