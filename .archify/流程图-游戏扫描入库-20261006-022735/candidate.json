  "cards": [
    {
      "dot": "cyan",
      "title": "引擎识别优先级（摘要）",
      "items": [
        "Siglus：Gameexe.dat + Scene.pck；FVP：*.hcb / *.bch；UK2：UK2.CFG 或 MES 头",
        "Ethornell / BGI 与 RealLive / AVG32：Gameexe.ini + SEEN 内容头分类；YURIS / CatSystem2 按特征评分",
        "System35、System4、SystemNNN、CMVS、Artemis、Tyrano / RPGM / Ren'Py / Ruffle / Web 依次判定；KRKR / ONS 在后",
        "命中即停止下钻，其子目录视为引擎资源；仅未命中任何特征且无运行时模块声明时才保留 UNKNOWN"
      ]
    },
    {
      "dot": "emerald",
      "title": "合并与写入语义",
      "items": [
        "手动添加的 PC / 安卓游戏与运行时模块绑定条目不参与扫描，重扫时原样保留",
        "旧条目的封面 / vndbId / 启动文件 / 模块包名等元数据保留，仅更新扫描字段",
        "落库经单线程 FIFO 写队列，成功后防抖 1.5s 写旧 prefs 作回滚镜像",
        "被重扫丢弃的 SystemNNN 条目进入副本清理队列，避免私有目录残留"
      ]
    },
    {
      "dot": "amber",
      "title": "扫描附带产物",
      "items": [
        "本地封面（cover.jpg / icon.png 等）命中即写入 coverUri",
        "识别结果写入 engine_detection_cache：Ren'Py 版本、RPGM 子运行时、mkxp-z 支持、Artemis 指纹",
        "ROM 文件（.iso / .pbp / .nsp 等）一 ROM 一条，launchTarget 为文件名",
        "第三方运行时模块只在 UNKNOWN / WEB_OTHER 弱结果上兜底，命中后改写为 RUNTIME_MODULE 并记录包名"
      ]
    }
  ]
