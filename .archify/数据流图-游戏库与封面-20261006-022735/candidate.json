  "cards": [
    {
      "dot": "cyan",
      "title": "权威与镜像",
      "items": [
        "Room（game_library.db）是唯一事实源；旧 prefs 仅做首次迁移导入与防抖回滚镜像",
        "扫描同时把 Ren'Py 版本 / RPGM 子运行时 / mkxp-z 支持 / Artemis 指纹写入 engine_detection_cache",
        "v3 新增 runtime_module_package，运行时模块绑定随游戏行持久化",
        "最近打开与快捷启动是派生视图，游戏行删除时外键级联清理；游戏时长单独存于 playtime_records"
      ]
    },
    {
      "dot": "emerald",
      "title": "封面管线",
      "items": [
        "来源按用户自定义顺序聚合（VNDB / NextMoe / Hikarinagi / Bangumi / Steam），本地封面优先命中",
        "NextMoe 支持「作品 → 多封面」两级选择；XSYS4 在本地与在线都无封面时用游戏图标兜底",
        "批量任务单飞执行，仅在封面快照未变时落库，避免覆盖用户手改",
        "封面独立磁盘缓存（covers_remote + preview），滚动感知解码避免滑动卡顿"
      ]
    },
    {
      "dot": "amber",
      "title": "消费与刷新",
      "items": [
        "库门面缓存持有内存快照与修订号 StateFlow，驱动四 Tab 与首页重载",
        "启动编排消费游戏条目与三级设置解析结果；宿主按 playtime 会话回写时长",
        "首页最近游玩卡片直接消费 playtime_records 展示时长与统计",
        "桌面快捷方式按 uri 哈希反查游戏，启动走同一编排入口"
      ]
    }
  ]
