  "cards": [
    {
      "dot": "cyan",
      "title": "权威与镜像",
      "items": [
        "Room（game_library.db）是唯一事实源；旧 prefs 仅做首次迁移导入与防抖回滚镜像",
        "扫描同时把 Ren'Py 版本建议 / RPGM 子运行时写入 engine_detection_cache",
        "最近打开与快捷启动是派生视图，游戏行删除时外键级联清理"
      ]
    },
    {
      "dot": "emerald",
      "title": "封面管线",
      "items": [
        "来源按用户自定义顺序聚合（VNDB / Bangumi / Steam / Hikarinagi），本地封面优先命中",
        "批量任务单飞执行，仅在封面快照未变时落库，避免覆盖用户手改",
        "封面独立磁盘缓存（covers_remote + preview），滚动感知解码避免滑动卡顿"
      ]
    },
    {
      "dot": "amber",
      "title": "消费与刷新",
      "items": [
        "库门面缓存持有内存快照与修订号 StateFlow，驱动四 Tab 与首页重载",
        "启动编排消费游戏条目与三级设置解析结果",
        "桌面快捷方式按 uri 哈希反查游戏，启动走同一编排入口"
      ]
    }
  ]
