  "cards": [
    {
      "dot": "cyan",
      "title": "插件安装生命周期",
      "items": [
        "Gradle 合并 engine / app 两处 nativeplugins 源，打成 assets/nativeplugins/*.zip 随 APK 分发",
        "首启 EnginePluginBootstrap 按 manifest 的 pluginVersion 幂等解压到 filesDir/engine_plugins/<engine>/current/arm64-v8a",
        "版本过期删除 current 重装；用户手动导入 zip 走 SHA-256 校验、zip-slip 防护与 staging 原子换名"
      ]
    },
    {
      "dot": "emerald",
      "title": "宿主与桥接机制",
      "items": [
        "宿主 Activity 各自独立 : 进程、singleInstance、sensorLandscape；主进程只负责编排",
        "Artemis 为 NativeActivity：系统 dlopen artemis_loader，按 engineLibName 白名单转发真实库",
        "krkr_bridge_v2 以 GOT/PLT patch 拦截 open/rename 等调用，实现 scopedSave、SAF 镜像与 patch overlay 重定向"
      ]
    },
    {
      "dot": "amber",
      "title": "Web 壳与 Rust 工具链",
      "items": [
        "Tyrano / RPG Maker 宿主自带本地 HTTP 服务（固定端口被占用回退随机）、asar 随机读与 JS 钩子注入",
        "Rust XP3 核心提供列举 / 解包 / 封包 JNI，附带进度原子槽与取消；catch_unwind 兜底 panic",
        "KSD mode-2 文本包裹在解包时顺带解开，krkrsdl3 引擎 TextStream 亦原生支持"
      ]
    }
  ]
}
