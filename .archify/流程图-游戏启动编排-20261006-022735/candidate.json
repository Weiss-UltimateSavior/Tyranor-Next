  "cards": [
    {
      "dot": "cyan",
      "title": "分流判定顺序（EngineLauncher）",
      "items": [
        "手动安卓游戏：按包名 getLaunchIntentForPackage 直接跳转",
        "外置模拟器：PSP/Switch 显式组件 + ROM URI；Winlator 走 ExternalLaunchActivity 协议",
        "外置 APK 模块：需目录时先申请所有文件访问，再走 JoiPlay Intent 协议",
        "其余进入内置引擎：插件保障 → 互通同步 → 镜像准备 → buildIntent"
      ]
    },
    {
      "dot": "emerald",
      "title": "启动前门与并发约束",
      "items": [
        "Artemis 补丁策略三选：启动时询问 / 自动 / 关闭（默认关闭）",
        "MV/MZ 互通关闭时检测标准存档并询问转化；开启时跳过弹窗",
        "同游戏会话运行中阻止重复启动（perGameLock + 进程后缀探测），取消异常原样传播"
      ]
    },
    {
      "dot": "amber",
      "title": "类型化结果与失败",
      "items": [
        "LaunchResult：Success / GameDirUnresolved / AllFilesAccessMissing / PluginBootstrapFailed 等 13 种",
        "外置错误码：模块未安装 / Activity 未找到 / 授权异常 / 启动异常",
        "core 只返回错误类型与错误码，本地化文案由 UI 层映射"
      ]
    }
  ]
