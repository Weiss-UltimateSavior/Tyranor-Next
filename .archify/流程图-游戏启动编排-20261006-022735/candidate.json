  "cards": [
    {
      "dot": "cyan",
      "title": "分流判定顺序（EngineLauncher）",
      "items": [
        "手动安卓游戏：按包名 getLaunchIntentForPackage 直接跳转",
        "第三方 RuntimeModule：刷新发现后按显式组件启动；缺失/禁用即降级为 UNKNOWN",
        "外置模拟器：PSP/Switch 显式组件 + ROM URI；Winlator 承载 PC / YU-RIS / CatSystem2",
        "外置 APK 模块：Ren'Py / RPGM / Ruffle，需目录时先申请所有文件访问",
        "其余内置：Ethornell 会话检查 → 插件保障 → 互通同步 → 镜像/预检 → 运行库 → buildIntent"
      ]
    },
    {
      "dot": "emerald",
      "title": "启动前门与并发约束",
      "items": [
        "Artemis 补丁策略三选：启动时询问 / 自动 / 关闭（默认关闭）",
        "MV/MZ 互通关闭时检测标准存档并询问转化；开启时跳过弹窗",
        "Ethornell 先做会话恢复/忙碌检查；System4 预检 ini 与 GLES 3.0；CMVS 检查旧实例与 launch.cfg",
        "同游戏会话运行中阻止重复启动（perGameLock + 进程后缀探测），锁序固定 perGameLock → INTEROP_LOCK"
      ]
    },
    {
      "dot": "amber",
      "title": "类型化结果与失败",
      "items": [
        "LaunchResult：Success + 34 种类型化失败（含 CMVS / System35 / System4 / Ethornell / RuntimeModule 专属错误）",
        "外置错误码 7 类：路径无效 / 未安装 / 版本过旧 / 准备失败 / Activity 未找到 / 授权异常 / 启动异常",
        "core 只返回错误类型与错误码，本地化文案由 UI 层映射；CMVS 异步失败经 LaunchFailureBus 回传"
      ]
    }
  ]
