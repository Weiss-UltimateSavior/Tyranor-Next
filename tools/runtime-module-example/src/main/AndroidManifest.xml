<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <application android:label="@string/app_name" android:theme="@android:style/Theme.Material.Light.NoActionBar"
        android:allowBackup="false" android:requestLegacyExternalStorage="true">
        <activity android:name=".LaunchActivity" android:exported="true">
            <intent-filter>
                <action android:name="com.tyranor.runtime.action.LAUNCH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data android:name="com.tyranor.runtime.MANIFEST" android:resource="@raw/tyranor_runtime" />
        </activity>
    </application>
</manifest>
