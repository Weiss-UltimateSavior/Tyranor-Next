+fn read_profile_marker(root: &Path) -> Result<Option<String>> {
+    let marker = match File::open(root.join("cmvs.profile")) {
+        Ok(file) => file,
+        Err(error) if error.kind() == std::io::ErrorKind::NotFound => return Ok(None),
+        Err(error) => return Err(error.into()),
+    };
+    let mut selector = String::new();
+    marker.take(129).read_to_string(&mut selector)?;
+    if selector.len() > 128 {
+        return Err("cmvs.profile exceeds 128 bytes".into());
+    }
+    Ok(Some(selector))
+}
+
+fn bootstrap_game(root: &Path, selected_profile: Option<&str>) -> Result<GameBootstrap> {
+    let fs = Arc::new(AndroidHostFs);
+    let marker = if selected_profile.is_none() {
+        read_profile_marker(root)?
+    } else {
+        None
+    };
+    let Some(selector) = selected_profile.or(marker.as_deref()) else {
+        return GameBootstrap::load(fs, root, None, EncodingPolicy::AutoDefaultShiftJis);
+    };
+    let registry = Registry::builtin();
+    let record = registry
+        .games()
+        .iter()
+        .find(|game| game.game == selector.trim())
+        .ok_or_else(|| {
+            cmvs_core::profile::SelectionError::UnknownProfile(selector.trim().into())
+        })?;
+    let profile = registry
+        .profile(&record.profile)
+        .ok_or("unknown engine profile")?;
+    let files = GameFiles::discover_with_fs(&*fs, root)?;
+    let game = Game {
+        files,
+        selection: ProfileSelection {
+            profile,
+            record: Some(record),
+            basis: SelectionBasis::Explicit,
+            evidence: Vec::new(),
+        },
+    };
+    log::info!(
+        "Using {} for {} without game hash identification",
+        if selected_profile.is_some() {
+            "launch.cfg profile"
+        } else {
+            "cmvs.profile"
+        },
+        record.game
+    );
+    GameBootstrap::from_game(fs, root, game, EncodingPolicy::AutoDefaultShiftJis)
+}
