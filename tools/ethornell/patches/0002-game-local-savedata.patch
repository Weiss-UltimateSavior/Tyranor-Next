+    #[test]
+    #[cfg(fd_policy)]
+    fn exact_game_savedata_root_is_user_only_and_persists_real_saves() {
+        use std::os::unix::fs::symlink;
+        let base = std::env::temp_dir().join(format!(
+            "ethornell-policy-{}-savedata",
+            std::process::id()
+        ));
+        let resource = base.join("game");
+        let savedata = resource.join("savedata");
+        std::fs::create_dir_all(&savedata).unwrap();
+        std::fs::write(resource.join("story.dat"), b"game asset").unwrap();
+        let p = FilePolicy::new(&resource, &savedata).unwrap();
+        p.atomic_write("UserData/slot.sud", b"save bytes").unwrap();
+        p.atomic_write("BGI.gdb", b"global data").unwrap();
+        p.atomic_write("BGI0007.cad", b"config").unwrap();
+        assert_eq!(p.read_user("UserData/slot.sud").unwrap(), b"save bytes");
+        assert_eq!(p.read_user("BGI.gdb").unwrap(), b"global data");
+        assert_eq!(p.read_user("BGI0007.cad").unwrap(), b"config");
+        assert_eq!(
+            std::fs::read(savedata.join("UserData/slot.sud")).unwrap(),
+            b"save bytes"
         );
+        assert_eq!(p.read_resource("story.dat", 100).unwrap(), b"game asset");
+        assert!(p.read_resource("savedata/UserData/slot.sud", 100).is_err());
+        assert!(p.read_loose("bgi-resource/savedata/UserData/slot.sud").is_err());
+        assert!(p.metadata("bgi-resource/savedata/UserData/slot.sud").is_none());
+        assert!(p.enumerate("bgi-resource/savedata/*", false, 0, false).is_err());
+        assert!(p.validate_resource_tree().is_ok());
+
+        // The resource walk must not descend into the user tree, while writes
+        // still reject symlink parents through the user-root descriptor.
+        std::fs::create_dir_all(savedata.join("escape")).unwrap();
+        let outside = base.join("outside");
+        std::fs::create_dir(&outside).unwrap();
+        symlink(&outside, savedata.join("link")).unwrap();
+        assert!(p.atomic_write("link/escaped", b"no").is_err());
+        assert!(!outside.join("escaped").exists());
+        std::fs::remove_dir_all(base).unwrap();
+    }
+    #[test]
+    #[cfg(fd_policy)]
+    fn only_non_symlink_direct_savedata_is_an_allowed_nested_root() {
+        use std::os::unix::fs::symlink;
+        let base = std::env::temp_dir().join(format!(
+            "ethornell-policy-{}-savedata-roots",
+            std::process::id()
+        ));
+        std::fs::create_dir_all(base.join("game/savedata")).unwrap();
+        std::fs::create_dir_all(base.join("game/other")).unwrap();
+        std::fs::create_dir_all(base.join("user")).unwrap();
+        let resource = base.join("game");
+        assert!(FilePolicy::new(&resource, &resource).is_err());
+        assert!(FilePolicy::new(&resource, &resource.join("other")).is_err());
+        assert!(FilePolicy::new(&resource, &base).is_err());
+        let symlink_game = base.join("symlink-game");
+        std::fs::create_dir(&symlink_game).unwrap();
+        symlink(resource.join("savedata"), symlink_game.join("savedata")).unwrap();
+        assert!(FilePolicy::new(&symlink_game, &symlink_game.join("savedata")).is_err());
         std::fs::remove_dir_all(base).unwrap();
     }
