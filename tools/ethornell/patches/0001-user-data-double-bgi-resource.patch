-    let normalized=name.replace('\\',"/");
+    let mut normalized=name.replace('\\',"/");
+    // A script can prepend the primary resource root to a name that already
+    // starts with it (`Sys80:32` resolves `bgi-resource\UserData\...` against
+    // `bgi-resource\`). Collapse exactly one duplicated prefix so the aliases
+    // below still match; every other resource name stays read-only and
+    // `relative()` continues to reject escapes.
+    if let Some(rest)=normalized.strip_prefix("bgi-resource/bgi-resource/") {
+        normalized=format!("bgi-resource/{rest}");
+    }
     if let Some(rest)=normalized.strip_prefix("bgi-resource/") {
         let first=rest.split('/').next().unwrap_or("");
         if first.eq_ignore_ascii_case("UserData") || rest.eq_ignore_ascii_case("BGI.gdb") {
             return format!("bgi-user/{rest}");
         }
+        // `Sys80:78/79` load and save config slots as validated-root +
+        // `BGI%04d.cad`. Once composed with the primary root those are explicit
+        // top-level resource names. Alias only these exact files; no other
+        // resource name, subdirectory, or traversal is writable.
+        let bytes=rest.as_bytes();
+        if bytes.len()==11
+            && bytes[..3].eq_ignore_ascii_case(b"BGI")
+            && bytes[3..7].iter().all(u8::is_ascii_digit)
+            && bytes[7..].eq_ignore_ascii_case(b".cad")
+        {
+            return format!("bgi-user/BGI{}.cad",&rest[3..7]);
+        }
     }
     normalized
 }
