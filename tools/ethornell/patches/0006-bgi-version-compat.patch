+            let meta = crate::parse_cbg_metadata(&bytes).unwrap();
+            assert_eq!((meta.width, meta.height, meta.bpp), (2, 3, bpp));
+            assert_eq!(pixels(&bytes, &meta).unwrap(), raw);
+            let decoded = crate::decode_image(&bytes).unwrap();
+            let expected: Vec<u8> = raw
+                .chunks(bpp as usize / 8)
+                .flat_map(|p| match bpp {
+                    8 => [p[0], p[0], p[0], 255],
