+        assert!(unpack_runs(&[1, 9], &mut [0; 3]).is_err());
+        let mut output = [0; 5];
+        unpack_runs(&[2, 5, 7, 2, 1, 9], &mut output).unwrap();
+        assert_eq!(output, [5, 7, 0, 0, 9]);
+    }
+}
