+//! Independently coded stripes in the 1.689 CompressedBG_MT decoder.
+//! The native decoder uses LSB-first Huffman bits and restarts its average
+//! predictor at every stripe (0x1400BEA80 / 0x1400BE6B0 in the tested binary).
+use super::{CbgV2Decoder, HuffmanTree, Reader};
+use crate::{CbgMetadata, DecodedImage};
+use ethornell_core::{EthornellError, Result};
+
+const MAX_PIXELS: usize = 64 * 1024 * 1024;
+const MAX_PACKED_BYTES: usize = 64 * 1024 * 1024;
+
+fn invalid(message: &str) -> EthornellError {
+    EthornellError::Parse(format!("CBG MT {message}"))
+}
+
+fn word(data: &[u8], at: usize) -> Result<u32> {
+    let bytes = data
+        .get(at..at + 4)
+        .ok_or_else(|| invalid("header is truncated"))?;
+    Ok(u32::from_le_bytes(bytes.try_into().unwrap()))
+}
+
+pub(crate) fn metadata(data: &[u8]) -> Result<CbgMetadata> {
+    if data.len() < 48 || !data.starts_with(b"CompressedBG_MT\0") {
+        return Err(invalid("header is missing or truncated"));
+    }
+    let width = word(data, 16)?;
+    let height = word(data, 20)?;
+    let rows = word(data, 24)?;
+    let bpp = word(data, 28)?;
+    if width == 0
+        || height == 0
+        || rows == 0
+        || width > u16::MAX as u32
+        || height > u16::MAX as u32
+        || (width as usize)
+            .checked_mul(height as usize)
+            .is_none_or(|n| n > MAX_PIXELS)
+    {
+        return Err(invalid("dimensions exceed the image budget"));
+    }
+    if !matches!(bpp, 8 | 24 | 32) {
+        return Err(EthornellError::UnsupportedFormat(
+            "CBG MT bit depth is unsupported".into(),
+        ));
+    }
+    Ok(CbgMetadata {
+        width,
+        height,
+        bpp,
+        image_subtype: 0,
+        embedded_point_flag: 0,
+        embedded_x: 0,
+        embedded_y: 0,
+        version: None,
+        intermediate_length: None,
+        encoded_length: None,
+        key: None,
+        checksum: None,
+        xor_check: None,
+    })
+}
+
+fn varint(input: &mut Reader<'_>) -> Result<u32> {
+    let mut value = 0u32;
+    for shift in (0..35).step_by(7) {
+        let byte = input.read_u8()?;
+        if shift == 28 && byte > 15 {
+            return Err(invalid("variable integer overflows"));
+        }
+        value |= u32::from(byte & 127) << shift;
+        if byte & 128 == 0 {
+            return Ok(value);
+        }
+    }
+    Err(invalid("variable integer is unterminated"))
+}
+
+fn unpack_runs(packed: &[u8], output: &mut [u8]) -> Result<()> {
+    let mut input = Reader::new(packed);
+    let mut position = 0usize;
+    let mut zero_run = false;
+    while input.pos < packed.len() {
+        let count = varint(&mut input)? as usize;
+        let end = position
+            .checked_add(count)
+            .filter(|&end| end <= output.len())
+            .ok_or_else(|| invalid("run exceeds its stripe"))?;
+        if !zero_run {
+            let bytes = packed
+                .get(input.pos..input.pos + count)
+                .ok_or_else(|| invalid("literal run is truncated"))?;
+            output[position..end].copy_from_slice(bytes);
+            input.pos += count;
+        }
+        position = end;
+        zero_run = !zero_run;
+    }
+    if position != output.len() {
+        return Err(invalid("run stream does not fill its stripe"));
+    }
+    Ok(())
+}
+
+fn stripe(data: &[u8], output: &mut [u8]) -> Result<()> {
+    let mut input = Reader::new(data);
+    let packed_len = word(data, 0)? as usize;
+    // Alternating one-byte runs are the largest valid representation, with
+    // at most one five-byte run length per literal byte and a final run.
+    if packed_len == 0
+        || packed_len > MAX_PACKED_BYTES
+        || packed_len > output.len().saturating_mul(6).saturating_add(10)
+    {
+        return Err(invalid("packed stripe exceeds its decoded budget"));
+    }
+    input.pos = 4;
+    let mut weights = Vec::with_capacity(256);
+    let mut total = 0u64;
+    for _ in 0..256 {
+        let weight = varint(&mut input)?;
+        total += u64::from(weight);
+        weights.push(weight);
+    }
+    if total != packed_len as u64 {
+        return Err(invalid(
+            "Huffman frequencies disagree with the stripe length",
+        ));
+    }
+    let tree = HuffmanTree::new(&weights, true);
+    let bits = input.remaining();
+    if packed_len > bits.len().saturating_mul(8) {
+        return Err(invalid(
+            "Huffman stripe cannot contain the declared symbol count",
+        ));
+    }
+    let mut bit_position = 0usize;
+    let mut packed = Vec::with_capacity(packed_len);
+    for _ in 0..packed_len {
+        let mut node = tree.nodes.len() - 1;
+        while tree.nodes[node].is_parent {
+            let byte = *bits
+                .get(bit_position / 8)
+                .ok_or_else(|| invalid("Huffman bitstream is truncated"))?;
+            let bit = byte >> (bit_position % 8) & 1;
+            bit_position += 1;
+            node = if bit == 0 {
+                tree.nodes[node].left_index
+            } else {
+                tree.nodes[node].right_index
+            };
+            if node >= tree.nodes.len() {
+                return Err(invalid("Huffman tree has an invalid child"));
+            }
+        }
+        packed.push(node as u8);
+    }
+    unpack_runs(&packed, output)
+}
+
+fn pixels(data: &[u8], meta: &CbgMetadata) -> Result<Vec<u8>> {
+    let rows = word(data, 24)? as usize;
+    let width = meta.width as usize;
+    let height = meta.height as usize;
+    let pixel_size = meta.bpp as usize / 8;
+    let stride = width * pixel_size;
+    let count = height.div_ceil(rows);
+    let header_end = 48 + count * 4;
+    if header_end > data.len() {
+        return Err(invalid("stripe offset table is truncated"));
+    }
+    let mut output = vec![0u8; stride * height];
+    for index in 0..count {
+        let start = word(data, 48 + index * 4)? as usize;
+        let end = if index + 1 == count {
+            data.len()
+        } else {
+            word(data, 52 + index * 4)? as usize
+        };
+        if start < header_end || start >= end || end > data.len() {
+            return Err(invalid("stripe offsets are invalid"));
+        }
+        let first_row = index * rows;
+        let stripe_rows = rows.min(height - first_row);
+        let target = &mut output[first_row * stride..(first_row + stripe_rows) * stride];
+        stripe(&data[start..end], target)?;
+        CbgV2Decoder::reverse_average_sampling(target, width, stripe_rows, stride, pixel_size);
+    }
+    Ok(output)
+}
+
+pub(crate) fn decode(data: &[u8]) -> Result<DecodedImage> {
+    let meta = metadata(data)?;
+    let pixels = pixels(data, &meta)?;
+    let mut rgba = Vec::with_capacity(meta.width as usize * meta.height as usize * 4);
+    for pixel in pixels.chunks_exact(meta.bpp as usize / 8) {
+        match meta.bpp {
+            8 => rgba.extend_from_slice(&[pixel[0], pixel[0], pixel[0], 255]),
+            24 => rgba.extend_from_slice(&[pixel[2], pixel[1], pixel[0], 255]),
+            32 => rgba.extend_from_slice(&[pixel[2], pixel[1], pixel[0], pixel[3]]),
+            _ => unreachable!("metadata validates the bit depth"),
+        }
+    }
+    Ok(DecodedImage {
+        width: meta.width,
+        height: meta.height,
+        rgba,
+    })
+}
+
+pub(crate) fn decode_native_buffer(data: &[u8]) -> Result<Vec<u8>> {
+    let meta = metadata(data)?;
+    let pixels = pixels(data, &meta)?;
+    let mut output = vec![0u8; 16];
+    output[..2].copy_from_slice(&(meta.width as u16).to_le_bytes());
+    output[2..4].copy_from_slice(&(meta.height as u16).to_le_bytes());
+    let bpp = if meta.bpp == 24 { 32 } else { meta.bpp as u16 };
+    output[4..6].copy_from_slice(&bpp.to_le_bytes());
+    if meta.bpp == 24 {
+        output[8..10].copy_from_slice(&7u16.to_le_bytes());
+        for pixel in pixels.chunks_exact(3) {
+            output.extend_from_slice(&[pixel[0], pixel[1], pixel[2], 0]);
+        }
+    } else {
+        output.extend_from_slice(&pixels);
+    }
+    Ok(output)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn push_varint(output: &mut Vec<u8>, mut value: u32) {
+        loop {
+            let byte = (value & 127) as u8;
+            value >>= 7;
+            output.push(byte | if value == 0 { 0 } else { 128 });
+            if value == 0 {
+                break;
+            }
+        }
+    }
+
+    fn paths(tree: &HuffmanTree, node: usize, path: &mut Vec<bool>, codes: &mut [Vec<bool>]) {
+        let current = &tree.nodes[node];
+        if !current.is_parent {
+            codes[node] = path.clone();
+            return;
+        }
+        path.push(false);
+        paths(tree, current.left_index, path, codes);
+        *path.last_mut().unwrap() = true;
+        paths(tree, current.right_index, path, codes);
+        path.pop();
+    }
+
+    fn encode_stripe(raw: &[u8], width: usize, pixel_size: usize) -> Vec<u8> {
+        let mut predicted = Vec::with_capacity(raw.len());
+        let stride = width * pixel_size;
+        for (at, &value) in raw.iter().enumerate() {
+            let x = at % stride / pixel_size;
+            let y = at / stride;
+            let prediction = match (x > 0, y > 0) {
+                (false, false) => 0,
+                (true, false) => u32::from(raw[at - pixel_size]),
+                (false, true) => u32::from(raw[at - stride]),
+                (true, true) => (u32::from(raw[at - pixel_size]) + u32::from(raw[at - stride])) / 2,
+            };
+            predicted.push(value.wrapping_sub(prediction as u8));
+        }
+        let mut packed = Vec::new();
+        push_varint(&mut packed, predicted.len() as u32);
+        packed.extend_from_slice(&predicted);
+        let mut weights = vec![0; 256];
+        for &byte in &packed {
+            weights[byte as usize] += 1;
+        }
+        let tree = HuffmanTree::new(&weights, true);
+        let mut codes = vec![Vec::new(); 256];
+        paths(&tree, tree.nodes.len() - 1, &mut Vec::new(), &mut codes);
+        let mut output = (packed.len() as u32).to_le_bytes().to_vec();
+        for weight in weights {
+            push_varint(&mut output, weight);
+        }
+        let mut bit = 0usize;
+        let mut bytes = Vec::new();
+        for byte in packed {
+            for &value in &codes[byte as usize] {
+                if bit % 8 == 0 {
+                    bytes.push(0);
+                }
+                bytes[bit / 8] |= u8::from(value) << (bit % 8);
+                bit += 1;
+            }
+        }
+        output.extend_from_slice(&bytes);
+        output
+    }
+
