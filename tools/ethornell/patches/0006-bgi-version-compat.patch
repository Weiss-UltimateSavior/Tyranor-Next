+        let mut output = vec![0u8; 56];
+        output[..16].copy_from_slice(b"CompressedBG_MT\0");
+        for (offset, value) in [(16, 2u32), (20, 3), (24, 2), (28, bpp)] {
+            output[offset..offset + 4].copy_from_slice(&value.to_le_bytes());
+        }
