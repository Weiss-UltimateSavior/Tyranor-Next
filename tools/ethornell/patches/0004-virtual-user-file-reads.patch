+#[cfg(all(test, fd_policy))]
+mod virtual_user_file_read_tests {
+    use super::*;
+
+    #[test]
+    fn runtime_disk_callbacks_map_save_aliases_without_collapsing_other_resources() {
+        use ethornell_vm::SysApi;
+
+        let base = std::env::temp_dir().join(format!(
+            "ethornell-runtime-disk-alias-{}",
+            std::process::id()
+        ));
+        let resource = base.join("resource");
+        let user = base.join("user");
+        std::fs::create_dir_all(resource.join("UserData")).unwrap();
+        std::fs::create_dir_all(&user).unwrap();
+        std::fs::write(resource.join("UserData/7.sud"), b"resource save").unwrap();
+        std::fs::write(resource.join("UserData/missing.sud"), b"resource-only save").unwrap();
+        std::fs::write(resource.join("story.arc"), b"ordinary resource").unwrap();
+        let policy = file_policy::FilePolicy::new(&resource, &user).unwrap();
+        policy
+            .atomic_write("bgi-resource\\UserData\\7.sud", b"private save")
+            .unwrap();
+
+        let mut api = RuntimeTraceApi::new_with_native_root(policy.open_manager().unwrap(), resource.clone());
+        api.host.enabled = true;
+        file_policy::scope(&policy, || {
+            assert_eq!(api.read_disk_file("bgi-resource\\UserData\\7.sud").unwrap(), b"private save");
+            assert!(api.disk_file_exists("bgi-resource\\UserData\\7.sud"));
+            assert_eq!(api.load_file_bytes("", "bgi-resource/UserData/7.sud").unwrap(), b"private save");
+            assert_eq!(api.load_file_bytes("bgi-resource/", "UserData/7.sud").unwrap(), b"private save");
+            assert!(api.load_file_bytes("", "bgi-resource/UserData/missing.sud").is_none());
+            assert!(!api.disk_file_exists("bgi-resource\\UserData\\missing.sud"));
+            assert_eq!(api.read_disk_file("bgi-resource\\bgi-resource\\story.arc").unwrap(), b"ordinary resource");
+            // Keep the existing metadata view even where raw read_loose strips
+            // another virtual prefix: this change only maps user-file aliases.
+            assert_eq!(
+                api.disk_file_exists("bgi-resource\\bgi-resource\\story.arc"),
+                policy.metadata("bgi-resource\\bgi-resource\\story.arc")
+                    .is_some_and(|meta| meta.is_file())
+            );
+            assert_eq!(
+                api.read_disk_file("bgi-resource\\bgi-resource\\story.arc").unwrap(),
+                policy.read_loose("bgi-resource\\bgi-resource\\story.arc").unwrap()
+            );
+            assert_eq!(policy.read_loose("bgi-resource\\UserData\\7.sud").unwrap(), b"resource save");
+        });
+        std::fs::remove_dir_all(base).unwrap();
+    }
+}
