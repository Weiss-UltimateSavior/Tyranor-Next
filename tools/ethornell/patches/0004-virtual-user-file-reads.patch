+/// A hosted BGI root is relative, but it is a virtual root understood by the
+/// host's restricted file policy. Keep this allowlist exact and require a
+/// separator boundary so lookalike roots (for example `bgi-resource-old`)
+/// never bypass the absolute-path guard.
+fn is_virtual_resource_path(path: &str) -> bool {
+    ["bgi-resource", "bgi-user"].iter().any(|root| {
+        path.strip_prefix(root)
+            .is_some_and(|suffix| suffix.starts_with(['\\', '/']))
+    })
+}
