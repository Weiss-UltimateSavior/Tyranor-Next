+#[cfg(fd_policy)]
+fn flock_operation_unsupported(error: &io::Error) -> bool {
+    error.raw_os_error().is_some_and(|code| {
+        code == libc::ENOSYS || code == libc::EOPNOTSUPP || code == libc::ENOTSUP
+    })
+}
+
+#[cfg(any(target_os = "android", target_os = "linux"))]
+fn lock_writer_with_ofd(file: &std::fs::File) -> io::Result<()> {
+    use std::os::fd::AsRawFd;
+
+    let mut lock = libc::flock {
+        l_type: libc::F_WRLCK as _,
+        l_whence: libc::SEEK_SET as _,
+        l_start: 0,
+        l_len: 0,
+        l_pid: 0,
+    };
+    if unsafe { libc::fcntl(file.as_raw_fd(), libc::F_OFD_SETLK, &mut lock) } < 0 {
+        return Err(io::Error::last_os_error());
+    }
+    Ok(())
+}
