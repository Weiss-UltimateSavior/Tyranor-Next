+/// Optional downstream ABI for original-stage filter processing. Call on the
+/// engine's owning thread with a live handle and at least ten writable u32s.
+/// Layout: logical W/H, configured Surface W/H, viewport X/Y/W/H, render serial
+/// low/high words. Actual geometry rejects an accidentally scaled producer;
+/// the serial distinguishes a rendered step from suppressed/messagebox steps.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn siglus_android_get_stage_geometry_v1(
+    handle: *mut c_void,
+    out_geometry: *mut u32,
+    out_count: u32,
+) -> i32 {
+    if handle.is_null() || out_geometry.is_null() || out_count < 10 {
+        return 0;
+    }
+    let host = unsafe { &mut *(handle as *mut SiglusHost) };
+    let (width, height) = host.logical_size();
+    let surface = host.renderer_mut().android_presentation_geometry();
+    let geometry = [
+        width, height, surface[0], surface[1], surface[2], surface[3], surface[4],
+        surface[5], surface[6], surface[7],
+    ];
+    unsafe { std::ptr::copy_nonoverlapping(geometry.as_ptr(), out_geometry, geometry.len()) };
+    1
+}
