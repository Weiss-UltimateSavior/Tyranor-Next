//!DESC VN-SR RGB2x reconstruction
//!HOOK MAIN
//!BIND MAIN
//!BIND vnsr_output_0
//!BIND vnsr_output_1
//!BIND vnsr_output_2
//!SAVE MAIN
//!WIDTH MAIN.w
//!HEIGHT MAIN.h
vec4 hook() {
vec2 cell=floor(MAIN_pos*MAIN_size);
ivec2 phase=ivec2(floor(fract(MAIN_pos*MAIN_size)*2.0));
int index=phase.y*2+phase.x;
vec2 center=(cell+vec2(0.5))*MAIN_pt;
vec3 residual=vec3(vnsr_output_0_tex(center)[index],vnsr_output_1_tex(center)[index],vnsr_output_2_tex(center)[index]);
return vec4(MAIN_tex(MAIN_pos).rgb+residual,1.0);
}
