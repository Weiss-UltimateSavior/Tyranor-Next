/**
 * Creates and installs a global `require` function that mimics Node.js functionality,
 * using a provided synchronous file system API (like NWJSApi).
 */
var require = (function() {

    /**
     * @class Module
     * @description Represents a single module, similar to Node.js.
     */
    class Module {
        constructor(id, parent) {
            this.id = id;
            this.filename = id; // Compatibility: module.filename is an alias for module.id
            this.exports = {};
            this.parent = parent;
            this.loaded = false;
            this.children = [];
            this.paths = []; // Populated during resolution
        }
    }

    /**
     * @class MiniRequire
     * @description The internal engine for the require system.
     */
    class MiniRequire {
        constructor() {
            this.cache = {}; // Module cache.
            this.main = null; // The main module, set after loading the entrypoint.

            // --- Error Constants ---
            this.ERR_MODULE_NOT_FOUND = 'MODULE_NOT_FOUND';
            this.ERR_INVALID_JSON = 'INVALID_JSON';

            // --- Default Extensions ---
            this.extensions = {
                '.js': (module, filename) => {
                    let content = NWJSApi.readFileSync(filename);
                    content = this._stripBOM(content);
                    content = this._stripShebang(content);
                    this._compileJs(module, content);
                },
                '.json': (module, filename) => {
                    let content = NWJSApi.readFileSync(filename);
                    content = this._stripBOM(content);
                    try {
                        module.exports = JSON.parse(content);
                    } catch (e) {
                        const err = new Error(`Error parsing ${filename}: ${e.message}`);
                        err.code = this.ERR_INVALID_JSON;
                        throw err;
                    }
                }
            };
        }

        require(id, parent = null) {

        console.log(`require'${id}'`)
            // FIX: Normalize execDir to ensure consistent separators (handled in _dirname now)
            const parentDir = parent ? this._dirname(parent.id) : this._dirname(this._normalize(NWJSApi.execDir()));
            const resolvedPath = this._resolve(id, parentDir);

            if (!resolvedPath) {
                const err = new Error(`Cannot find module '${id}'`);
                err.code = this.ERR_MODULE_NOT_FOUND;
                throw err;
            }

            if (this.cache[resolvedPath]) {
                return this.cache[resolvedPath].exports;
            }

            const module = new Module(resolvedPath, parent);
            this.cache[resolvedPath] = module;

            // Handle circular dependencies by caching before loading
            try {
                this._load(module);
            } catch (err) {
                delete this.cache[resolvedPath];
                throw err;
            }

            return module.exports;
        }

        _resolve(id, parentDir) {
            console.log(`resolving '${id}' in '${parentDir}'`)
            // Normalize slashes for internal consistency
            id = this._normalize(id);
            parentDir = this._normalize(parentDir);

            // Handle absolute paths
            if (id.startsWith('/')) {
                return this._tryFileOrDirectory(id);
            }

            // Handle relative paths
            if (id.startsWith('./') || id.startsWith('../')) {
                const absolutePath = this._join(parentDir, id);
                return this._tryFileOrDirectory(absolutePath);
            }

            // Handle node_modules
            return this._resolveNodeModule(id, parentDir);
        }

        _tryFileOrDirectory(path) {
            // 1. Try as file (exact, .js, .json)
            const fileRes = this._resolveAsFile(path);
            if (fileRes) return fileRes;

            // 2. Try as directory (package.json, index.js, etc.)
            const dirRes = this._resolveAsDirectory(path);
            if (dirRes) return dirRes;

            return null;
        }

        _resolveAsFile(path) {
            if (this._isFile(path)) return path;
            if (this._isFile(path + '.js')) return path + '.js';
            if (this._isFile(path + '.json')) return path + '.json';
            return null;
        }

        _resolveAsDirectory(dirPath) {
            if (!this._isDirectory(dirPath)) return null;

            const pkgPath = this._join(dirPath, 'package.json');

            if (this._isFile(pkgPath)) {
                try {
                    const json = NWJSApi.readFileSync(pkgPath);
                    const pkg = JSON.parse(this._stripBOM(json));

                    if (pkg.main) {
                        const mainPath = this._join(dirPath, pkg.main);
                        const mainRes = this._tryFileOrDirectory(mainPath);
                        if (mainRes) return mainRes;
                    }
                } catch (e) {
                    // Ignore invalid package.json
                }
            }

            // Fallback to index.js / index.json
            const indexJs = this._join(dirPath, 'index.js');
            if (this._isFile(indexJs)) return indexJs;

            const indexJson = this._join(dirPath, 'index.json');
            if (this._isFile(indexJson)) return indexJson;

            return null;
        }

        _resolveNodeModule(id, startDir) {
            let currentDir = startDir;
            while (true) {
                const nodeModulesDir = this._join(currentDir, 'node_modules');

                if (this._isDirectory(nodeModulesDir)) {
                    const modulePath = this._join(nodeModulesDir, id);
                    const res = this._tryFileOrDirectory(modulePath);
                    if (res) return res;
                }

                const parent = this._dirname(currentDir);
                if (parent === currentDir) break;
                currentDir = parent;
            }
            return null;
        }

        _load(module) {
            const extension = this._extname(module.id) || '.js';

            // Use registered extension loader if available, otherwise default to .js (Node behavior)
            const loader = this.extensions[extension] || this.extensions['.js'];
            loader(module, module.id);

            module.loaded = true;
        }

        _compileJs(module, content) {
            // FIX: Add sourceURL for better debugging in DevTools
            const sourceURL = '//# sourceURL=' + module.id.replace(/\\/g, '/');

            // Wrap code to provide scope isolation
            const wrapper =
                '(function(exports, require, module, __filename, __dirname) {\n' +
                content +
                '\n\n' + sourceURL + '\n});';

            const compiledWrapper = eval(wrapper);

            const requireForModule = (id) => {
                return this.require(id, module);
            };

            // Map require properties
            requireForModule.resolve = (id) => this._resolve(id, this._dirname(module.id));
            requireForModule.cache = this.cache;
            requireForModule.main = this.main;
            requireForModule.extensions = this.extensions; // Expose extensions

            const dirname = this._dirname(module.id);

            compiledWrapper.call(
                module.exports, // 'this' context
                module.exports,
                requireForModule,
                module,
                module.id,
                dirname
            );
        }

        // --- Helpers ---

        _normalize(path) {
            // Standardize to forward slashes for internal logic
            return path ? path.replace(/\\/g, '/') : path;
        }

        _stripBOM(content) {
            if (content.charCodeAt(0) === 0xFEFF) {
                return content.slice(1);
            }
            return content;
        }

        _stripShebang(content) {
            if (content.startsWith('#!')) {
                const index = content.indexOf('\n');
                if (index !== -1) {
                    // Replace shebang line with empty lines to preserve line numbers
                    return '\n' + content.slice(index);
                }
            }
            return content;
        }

        _extname(path) {
            const match = path.match(/\.[^.]+$/);
            return match ? match[0] : '';
        }

        _dirname(path) {
            path = this._normalize(path);
            const parts = path.split('/').filter(p => p);
            if (parts.length === 0) return '.';
            if (parts.length === 1 && path.startsWith('/')) return '/';
            parts.pop();
            const res = parts.join('/');
            return (path.startsWith('/') ? '/' : '') + (res || (path.startsWith('/') ? '' : '.'));
        }

        _join(...paths) {
            // Normalize all input paths first
            paths = paths.map(p => this._normalize(p));

            const newPath = paths.join('/');
            const resolved = [];
            const parts = newPath.split('/').filter(p => p && p !== '.');

            for (const part of parts) {
                if (part === '..') { resolved.pop(); }
                else { resolved.push(part); }
            }

            return (newPath.startsWith('/') ? '/' : '') + resolved.join('/');
        }

        _isFile(path) {
            try {
                if (NWJSApi.statSync) {
                    return NWJSApi.statSync(path).isFile();
                }
                return NWJSApi.existsSync(path) && !this._isDirectory(path);
            } catch (e) {
                return false;
            }
        }

        _isDirectory(path) {
            try {
                if (NWJSApi.statSync) {
                    return NWJSApi.statSync(path).isDirectory();
                }
                return NWJSApi.existsSync(path);
            } catch (e) {
                return false;
            }
        }
    }

    // Create the single, hidden instance of our require engine.
    const engine = new MiniRequire();

    // This is the function that will become the global `require`.
    const globalRequire = (id) => engine.require(id);

    // Attach properties to the global function
    globalRequire.cache = engine.cache;
    globalRequire.extensions = engine.extensions;
    globalRequire.main = null;

    // We need to link `require.main` to the engine's main module.
    Object.defineProperty(globalRequire, 'main', {
        get: () => engine.main,
        set: (val) => { engine.main = val; }
    });

    globalRequire.resolve = (id) => engine._resolve(id, engine._dirname(engine._normalize(NWJSApi.execDir())));

    return globalRequire;

})();