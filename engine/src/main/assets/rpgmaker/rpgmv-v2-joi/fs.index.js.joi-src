'use strict';

class Stats {
    constructor(){
        this.path = "";
        this.dev = 0;
        this.ino = 0;
        this.mode = 0;
        this.nlink = 1;
        this.uid = 0;
        this.gid = 0;
        this.rdev = 0;
        this.size = 0;
        this.blksize = 0;
        this.blocks = 0;
        this.atimeMs = 0.1;
        this.mtimeMs = 0.1;
        this.ctimeMs = 0.1;
        this.birthtimeMs = 0.1;
    }
    
    isFile(){
        return NWJSApi.isFile(this.path);
    }
    
    isDirectory(){
        return NWJSApi.isDir(this.path);
    }
}

class WriteStream {
    constructor(...argv){
        if(argv.length == 1){
            [this.path] = argv;
        } else {
            [this.path, this.options] = argv;
        }
        
        this.pending = false;
        this.destroyed = false;
        this.chunks = [];
    }
    
    close(...argv){
        let buffer = Buffer.concat(this.chunks).toString();
        NWJSApi.writeFileSync(this.path, buffer);
        
        this.destroyed = true;
    }
    
    cork(...argv){
    }
    
    destroy(...argv){
        let buffer = Buffer.concat(this.chunks).toString();
        NWJSApi.writeFileSync(this.path, buffer);
        
        this.destroyed = true;
    }
    
    end(chunk){
        if(typeof chunk === 'string' || chunk instanceof String){
            this.chunks.push(Buffer.from(chunk));
        } else {
            this.chunks.push(chunk);
        }
        
        let buffer = Buffer.concat(this.chunks).toString();
        NWJSApi.writeFileSync(this.path, buffer);
    }
    
    setDefaultEncoding(...argv){
    }
    
    uncork(...argv){
    }
    
    write(chunk){
        if(typeof chunk === 'string' || chunk instanceof String){
            this.chunks.push(Buffer.from(chunk));
        } else {
            this.chunks.push(chunk);
        }
    }
    
    get writableEnded(){
        return !this.destroyed;
    }
    
    get writableCorked(){
        return false;
    }
    
    get writableFinished(){
        return this.destroyed;
    }
    
    get writableHighWaterMark(){
        return 0;
    }
    
    get writableLength(){
        return 0;
    }
    
    get writableNeedDrain(){
        return false;
    }
    
    get writableObjectMode(){
        return false;
    }
}

module.exports = {
    existsSync: function (path){
        return NWJSApi.existsSync(path);
    },
    
    writeFile: function (...argv){
        let path, data, options, callback;
        if(argv.length == 4) {
            [path, data, options, callback] = argv;
        } else {
            [path, data, callback] = argv;
        }
        
        NWJSApi.writeFileSync(path, JSON.stringify(Buffer.from(data).toJSON()));

        if (callback instanceof Function){
            callback(null);
        }

    },
    
    writeFileSync: function (path, data, options = ""){
        NWJSApi.writeFileSync(path, JSON.stringify(Buffer.from(data).toJSON()));
    },
    
    appendFile: function (...argv){
        let path, data, options, callback;
        if(argv.length == 4) {
            [path, data, options, callback] = argv;
        } else {
            [path, data, callback] = argv;
        }
        
        NWJSApi.appendFileSync(path, data);
        
        if(callback != null) callback(null);
    },

    appendFileSync: function (file, data, options){
        NWJSApi.appendFileSync(file, data);
    },

    unlink: function (path, callback){
        NWJSApi.unlinkSync(path);
        if(callback != null) callback(null);
    },

    unlinkSync: function (path){
        NWJSApi.unlinkSync(path);
    },
    
    remove: function (path, callback){
        NWJSApi.unlinkSync(path);
        if(callback != null) callback(null);
    },

    removeSync: function (path){
        NWJSApi.unlinkSync(path);
    },

    readFile: function (...argv){
        let data, path, options, callback;
        if(argv.length == 3) {
            [path, options, callback] = argv;
        } else {
            [path, callback] = argv;
        }

        if(typeof options === 'string' || options instanceof String){
          if(options.length > 3){
            data = NWJSApi.readFileSync(path, options);
            if(data === "\b\b\b"){
              throw new Error(`readFile: Failed to read ${path}`)
            }
          }
        } else if(options && options.encoding){
          data = NWJSApi.readFileSync(path, options.encoding);
          if(data === "\b\b\b"){
            throw new Error(`readFile: Failed to read ${path}`)
          }
        } else {
          data = NWJSApi.readFileSync(path, '')
          if(data === "\b\b\b"){
            throw new Error(`readFile: Failed to read ${path}`)
          }
          data = Buffer.from(JSON.parse(data));
        }

        if (callback instanceof Function){
            callback(null, data);
        }
    },

    readFileSync: function (...argv){
        let data, path, options;
        if(argv.length == 2) {
            [path, options] = argv;
        } else {
            [path] = argv;
        }

        if(typeof options === 'string' || options instanceof String){
          if(options.length > 3){
            data = NWJSApi.readFileSync(path, options);
            if(data === "\b\b\b"){
              throw new Error(`readFileSync: Failed to read ${path}`)
            }
          }
        } else if(options && options.encoding){
          data = NWJSApi.readFileSync(path, options.encoding);
          if(data === "\b\b\b"){
            throw new Error(`readFileSync: Failed to read ${path}`)
          }
        } else {
          data = NWJSApi.readFileSync(path, '')
          if(data === "\b\b\b"){
            throw new Error(`readFileSync: Failed to read ${path}`)
          }
          data = Buffer.from(JSON.parse(data));
        }

        return data;
    },

    readdir: function (...argv){
        let path, options, callback;
        if(argv.length == 3) {
            [path, options, callback] = argv;
        } else {
            [path, callback] = argv;
        }
        
        let dir = JSON.parse(NWJSApi.readdirSync(path));
        
        if(callback != null) callback(null, dir)
    },

    readdirSync: function (path, options){
        return JSON.parse(NWJSApi.readdirSync(path));
    },

    mkdir: function (...argv){
        let path, options, callback;
        if(argv.length == 3) {
            [path, options, callback] = argv;
        } else {
            [path, callback] = argv;
        }
        
        NWJSApi.mkdirSync(path);
        
        if(callback != null) callback(null);
    },

    mkdirSync: function (path, options){
        return NWJSApi.mkdirSync(path);
    },

    rename: function (f1, f2, callback){
        NWJSApi.renameFileSync(f1,f2);
        if(callback != null) callback(null);
    },

    renameSync: function (f1, f2){
        return NWJSApi.renameFileSync(f1,f2);
    },
    
    copyFile: function (...argv){
        let path, options, callback;
        if(argv.length == 4) {
            [source, target, mode, callback] = argv;
        } else{
            [source, target, callback] = argv;
        }
        
        NWJSApi.copyFileSync(source,target);
        if(callback != null) callback(null);
    },

    copyFileSync: function (...argv){
        let path, options, callback;
        if(argv.length == 3) {
            [source, target, mode] = argv;
        } else{
            [source, target] = argv;
        }
        
        return NWJSApi.copyFileSync(source, target);
    },

    Stats: new Stats(),
    
    stat: function (...argv){
        let path, options, callback;
        if(argv.length == 3) {
            [path, options, callback] = argv;
        } else {
            [path, callback] = argv;
        }
        
        let stats = new Stats();
        stats.path = path;
        
        if(callback != null) callback(null, stats);
    },

    statSync: function (path){
        let stats = new Stats();
        stats.path = path;
        return stats;
    },
    
    lstat: function (...argv){
        let path, options, callback;
        if(argv.length == 3) {
            [path, options, callback] = argv;
        } else {
            [path, callback] = argv;
        }
        
        let stats = new Stats();
        stats.path = path;
        
        if(callback != null) callback(null, stats);
    },

    lstatSync: function (path){
        let stats = new Stats();
        stats.path = path;
        return stats;
    },
    
    createWriteStream: function(...argv){
        return new WriteStream(...argv);
    }
};
