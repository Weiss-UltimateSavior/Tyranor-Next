var nw = {}

if (typeof global !== "undefined" && global.nw) {
    nw = global.nw
} else if (typeof window !== "undefined" && window.nw) {
    nw = window.nw
} else {
    nw = {}
}

nw.gui = {}

nw.gui.App = {}

nw.gui.App.dataPath = NWJSApi.execDir()+"/AppData"
nw.gui.App.argv = [""]

nw.gui.Shell = {}
nw.gui.Shell.openExternal = function(url){}

nw.App = nw.gui.App

nw.Window = {}

nw.Window.showDevTools = function(){};
nw.Window.closeDevTools = function(){};
nw.Window.isDevToolsOpen = function(){};
nw.Window.removeAllListeners = function(){};
nw.Window.on = function(name, func){
    window.addEventListener(name, func)
};

nw.Window.open = function(url, options, callback){
   window.open(url)
};

nw.Window.get = function(){
    var win = nw.Window;
    return win;
};

nw.Window.setAlwaysOnTop = function(){};

nw.Window.window = function(){
    return window;
};

nw.Window.x = 0;

nw.Window.y = 0;

nw.Window.title = "JoiPlay";

nw.Window.width = 1270;

nw.Window.height = 720;

nw.Window.isAlwaysOnTop = false;

nw.Window.isFullscreen = true;

nw.Window.focus = function(){};

nw.Window.blur = function(){};

nw.Window.hide = function(){};

nw.Window.show = function(isShown = true){};

nw.Window.close = function(force = false){};

nw.Window.maximize = function(){};
nw.Window.minimize = function(){};
nw.Window.restore = function(){};

nw.Window.captureScreenshot = function(options, callback = 1){};

nw.gui.Window = nw.Window

class Clipboard {
    constructor() {}

    get(type){
       return NWJSApi.getClipboard();
    }

    set(text){
        NWJSApi.setClipboard(text);
    }

    readAvailableTypes(){
        return ["text"];
    }
}

nw.gui.Clipboard = {}

nw.gui.Clipboard.get = function(){
    return new Clipboard();
}

nw.__dirname = NWJSApi.execDir();

nw.process = require("process");

module.exports = nw