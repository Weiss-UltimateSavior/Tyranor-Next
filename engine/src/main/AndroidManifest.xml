<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application>

        <!-- Kirikiri（kr/krkr2）引擎宿主，独立进程隔离 SDL2 原生符号 -->
        <activity
            android:name="com.akira.tyranoemu.remote.Kirikiroid139"
            android:exported="false"
            android:process=":kirikiri2"
            android:launchMode="singleInstance"
            android:taskAffinity="com.core.Kirikiroid2"
            android:screenOrientation="sensorLandscape"
            android:windowSoftInputMode="adjustPan"
            android:configChanges="keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density|fontScale|locale|layoutDirection" />
        <activity
            android:name="com.akira.tyranoemu.remote.Kirikiroid134"
            android:exported="false"
            android:process=":kirikiri2"
            android:launchMode="singleInstance"
            android:taskAffinity="com.core.Kirikiroid2"
            android:screenOrientation="sensorLandscape"
            android:windowSoftInputMode="adjustPan"
            android:configChanges="keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density|fontScale|locale|layoutDirection" />
        <!-- krkrsdl3 引擎（SDL3 内核，独立入口/独立进程，与 :kirikiri2 隔离） -->
        <activity
            android:name="com.core.krkrsdl3.Krkrsdl3Activity"
            android:exported="false"
            android:process=":krkrsdl3"
            android:launchMode="singleInstance"
            android:taskAffinity="com.core.Krkrsdl3"
            android:theme="@style/Theme.Krkrsdl3"
            android:screenOrientation="sensorLandscape"
            android:configChanges="keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density|fontScale|locale|layoutDirection" />

        <!-- Tyrano（ty）WebView 宿主 -->
        <activity
            android:name="com.core.tyrano.TyranoActivity"
            android:exported="false"
            android:process=":tyrano"
            android:launchMode="singleInstance"
            android:taskAffinity="com.core.Tyrano"
            android:screenOrientation="sensorLandscape"
            android:configChanges="keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density|fontScale|locale|layoutDirection" />

        <!-- RPG Maker MV/MZ 独立运行时（v1/v2）：WebView 宿主，独立进程与 tyrano(:tyrano) 隔离 -->
        <activity
            android:name="com.core.rpgmaker.RpgMakerActivity"
            android:exported="false"
            android:process=":rpgmaker"
            android:launchMode="singleInstance"
            android:taskAffinity="com.core.RpgMaker"
            android:screenOrientation="sensorLandscape"
            android:configChanges="keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density|fontScale|locale|layoutDirection" />

        <!-- Artemis（ar）原生引擎宿主 -->
        <activity
            android:name="com.akira.tyranoemu.remote.ArtemisActivityV1"
            android:exported="false"
            android:process=":artemis"
            android:launchMode="singleInstance"
            android:taskAffinity="com.core.Artemis"
            android:screenOrientation="sensorLandscape"
            android:windowSoftInputMode="adjustPan"
            android:configChanges="keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density|fontScale|locale|layoutDirection">
            <meta-data android:name="android.app.lib_name" android:value="artemis_loader" />
        </activity>
        <activity
            android:name="com.akira.tyranoemu.remote.ArtemisActivityV2"
            android:exported="false"
            android:process=":artemis.compat"
            android:launchMode="singleInstance"
            android:taskAffinity="com.core.Artemis"
            android:screenOrientation="sensorLandscape"
            android:windowSoftInputMode="adjustPan"
            android:configChanges="keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density|fontScale|locale|layoutDirection">
            <meta-data android:name="android.app.lib_name" android:value="artemis_loader" />
        </activity>
        <activity
            android:name="com.akira.tyranoemu.remote.ArtemisActivityV6"
            android:exported="false"
            android:process=":artemis.v6"
            android:launchMode="singleInstance"
            android:taskAffinity="com.core.Artemis"
            android:screenOrientation="sensorLandscape"
            android:windowSoftInputMode="adjustPan"
            android:configChanges="keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density|fontScale|locale|layoutDirection">
            <meta-data android:name="android.app.lib_name" android:value="artemis_loader" />
        </activity>
        <!-- 自研 clean-room 兼容内核（artemis-compat）：独立进程，严格自研往返不参与官方回退链 -->
        <activity
            android:name="com.akira.tyranoemu.remote.ArtemisActivityClean"
            android:exported="false"
            android:process=":artemis.clean"
            android:launchMode="singleInstance"
            android:taskAffinity="com.core.Artemis"
            android:screenOrientation="sensorLandscape"
            android:windowSoftInputMode="adjustPan"
            android:configChanges="keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density|fontScale|locale|layoutDirection">
            <meta-data android:name="android.app.lib_name" android:value="artemis_loader" />
        </activity>

        <!-- SiglusEngine（siglus_rs）宿主：关闭滤镜沿用 SurfaceView；开启滤镜使用 TextureView + 私有 producer -->
        <activity
            android:name="com.core.siglus.SiglusActivity"
            android:exported="false"
            android:process=":siglus"
            android:launchMode="singleInstance"
            android:taskAffinity="com.core.Siglus"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/Theme.Siglus"
            android:windowSoftInputMode="adjustNothing"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|density|fontScale|locale|layoutDirection">
        </activity>

        <!-- Host-driven Ethornell runtime: VM/GPU calls are owned by its dedicated engine thread. -->
        <activity
            android:name="com.core.ethornell.EthornellActivity"
            android:exported="false"
            android:process=":ethornell"
            android:launchMode="singleInstance"
            android:taskAffinity="com.core.Ethornell"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/Theme.Ethornell"
            android:windowSoftInputMode="adjustNothing"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|density|fontScale|locale|layoutDirection" />

        <!-- CMVS NativeActivity + loader: loader forwards only ANativeActivity_onCreate. -->
        <activity
            android:name="com.core.cmvs.CmvsActivity"
            android:exported="false"
            android:process=":cmvs"
            android:launchMode="singleInstance"
            android:taskAffinity="com.core.Cmvs"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/Theme.Cmvs"
            android:windowSoftInputMode="adjustNothing"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|layoutDirection|screenLayout|screenSize|smallestScreenSize|uiMode|density|fontScale|locale">
            <meta-data android:name="android.app.lib_name" android:value="cmvs_loader" />
        </activity>

        <!-- FVPEngine（rfvp）宿主：Java SurfaceView + Choreographer 主循环驱动 Rust 引擎 -->
        <activity
            android:name="com.core.fvp.FvpActivity"
            android:exported="false"
            android:process=":fvp"
            android:launchMode="singleInstance"
            android:taskAffinity="com.core.Fvp"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/Theme.Fvp"
            android:windowSoftInputMode="adjustNothing"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|density|fontScale|locale|layoutDirection">
        </activity>

        <!-- RealLive / AVG32 / UK2（framebuffer 软渲染）宿主：Choreographer 主循环 + Bitmap 呈现 -->
        <activity
            android:name="com.core.games.FramebufferGameActivity"
            android:exported="false"
            android:process=":fbgames"
            android:launchMode="singleInstance"
            android:taskAffinity="com.core.FramebufferGames"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/Theme.FramebufferGames"
            android:windowSoftInputMode="adjustNothing"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|density|fontScale|locale|layoutDirection">
        </activity>

        <!-- System3.x（xsystem35）宿主：SDL2 主循环（vendored org.libsdl.app32 2.32.10） -->
        <activity
            android:name="com.core.xsys35.Xs35Activity"
            android:exported="false"
            android:process=":xsys35"
            android:launchMode="singleInstance"
            android:taskAffinity="com.core.Xsys35"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/Theme.Xsys35"
            android:windowSoftInputMode="adjustPan"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|density|fontScale|locale|layoutDirection" />

        <!-- System4（xsystem4）宿主：SDL2 主循环（共用 org.libsdl.app32 2.32.10） -->
        <activity
            android:name="com.core.xsys4.Xs4Activity"
            android:exported="false"
            android:process=":xsys4"
            android:launchMode="singleInstance"
            android:taskAffinity="com.core.Xsys4"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/Theme.Xsys4"
            android:windowSoftInputMode="adjustPan"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|density|fontScale|locale|layoutDirection" />
        <!-- System4 游戏手册页（WebView，只读游戏 Manual/，与宿主同进程） -->
        <activity
            android:name="com.core.xsys4.Xs4ManualActivity"
            android:exported="false"
            android:process=":xsys4"
            android:taskAffinity="com.core.Xsys4"
            android:theme="@style/Theme.Xsys4" />

        <activity
            android:name="com.tyranor.runtime.systemnnn.PlayerActivity"
            android:exported="false"
            android:process=":systemnnn"
            android:taskAffinity="${applicationId}.systemnnn"
            android:screenOrientation="sensorLandscape"
            android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|density|fontScale|locale|layoutDirection" />

        <!-- ONS（ons）SDL2 宿主 -->
        <activity
            android:name="com.yuri.onscripter.ONScripter"
            android:exported="false"
            android:process=":ons"
            android:launchMode="singleInstance"
            android:taskAffinity="com.core.ONScripter"
            android:screenOrientation="sensorLandscape"
            android:configChanges="keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density|fontScale|locale|layoutDirection" />
        <activity
            android:name="com.ies_net.artemis.VideoViewActivity"
            android:exported="false"
            android:process=":artemis"
            android:screenOrientation="sensorLandscape"
            android:configChanges="keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density|fontScale|locale|layoutDirection" />

    </application>

</manifest>
