--- a/src/tyranor_paths.h
+++ b/src/tyranor_paths.h
@@ -0,0 +1,66 @@
+#pragma once
+
+// Tyranor host adapter. Only app-generated paths may be passed here.
+// The Android host performs identity, private-root containment and manifest
+// validation; these checks also fail closed before changing CWD or running Lua.
+#include <filesystem>
+#include <fstream>
+#include <stdexcept>
+#include <string>
+#include <string_view>
+
+namespace Impacto::Tyranor {
+inline std::string RequiredArgument(int argc, char* argv[], std::string_view key) {
+  std::string value;
+  bool found = false;
+  for (int i = 1; i < argc; ++i) {
+    if (std::string_view(argv[i]) != key) continue;
+    if (found || i + 1 >= argc || argv[i + 1][0] == '\0') {
+      throw std::invalid_argument("Missing or duplicate Tyranor launch argument");
+    }
+    found = true;
+    value = argv[++i];
+  }
+  if (!found) throw std::invalid_argument("Missing Tyranor launch argument");
+  return value;
+}
+
+inline void RequireReadableFile(std::filesystem::path const& path) {
+  if (!path.is_absolute() || !std::filesystem::is_regular_file(path) ||
+      !std::ifstream(path, std::ios::binary).good()) {
+    throw std::invalid_argument("Tyranor configuration must be an absolute readable file");
+  }
+}
+
+inline std::filesystem::path ValidateLaunch(int argc, char* argv[]) {
+  // The host contract is a closed set of flag/value pairs. In particular,
+  // standalone --patch/-p and configuration aliases cannot bypass validation.
+  for (int i = 1; i < argc; i += 2) {
+    std::string_view key = argv[i];
+    if ((key != "--tyranor-resource-root" && key != "-bp" && key != "-gc" &&
+         key != "-uc" && key != "-g") || i + 1 >= argc ||
+        argv[i + 1][0] == '\0' || argv[i + 1][0] == '-') {
+      throw std::invalid_argument("Unsupported Tyranor launch argument");
+    }
+  }
+  std::filesystem::path root = RequiredArgument(argc, argv, "--tyranor-resource-root");
+  if (!root.is_absolute() || !std::filesystem::is_directory(root) ||
+      std::filesystem::canonical(root) != root.lexically_normal()) {
+    throw std::invalid_argument("Invalid Tyranor resource generation root");
+  }
+  for (auto const* directory : {"profiles", "resources", "shaders"}) {
+    if (!std::filesystem::is_directory(root / directory)) {
+      throw std::invalid_argument("Incomplete Tyranor resource generation");
+    }
+  }
+  RequireReadableFile(RequiredArgument(argc, argv, "-bp"));
+  RequireReadableFile(RequiredArgument(argc, argv, "-gc"));
+  std::filesystem::path config = RequiredArgument(argc, argv, "-uc");
+  if (!config.is_absolute() || !std::filesystem::is_directory(config.parent_path())) {
+    throw std::invalid_argument("Invalid Tyranor user configuration path");
+  }
+  if (std::filesystem::exists(config)) RequireReadableFile(config);
+  RequiredArgument(argc, argv, "-g");
+  return root;
+}
+}  // namespace Impacto::Tyranor
