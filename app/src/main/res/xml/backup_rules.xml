<?xml version="1.0" encoding="utf-8"?><!--
   Auto-backup rules (API < 31). See https://developer.android.com/guide/topics/data/autobackup
   for details.
-->
<full-backup-content>
    <!-- Keep the default backup domains, including root/games and ordinary preferences,
         files and other engine saves. A lone include would turn this into an allowlist
         and omit unrelated app data. Preserve the exclusions below; quota/transport
         policy still applies, so users should explicitly export important saves. -->
    <exclude domain="sharedpref" path="webdav_sync_secure.xml" />
    <exclude domain="sharedpref" path="hikarinagi_auth.xml" />
    <!-- OAuth 令牌加密库：Keystore 密钥换机不可解密，必须排除 -->
    <exclude domain="sharedpref" path="hikarinagi_auth_secure.xml" />
    <exclude domain="sharedpref" path="bangumi_auth_secure.xml" />
    <exclude domain="sharedpref" path="vndb_auth_secure.xml" />
    <exclude domain="sharedpref" path="nextmoe_auth_secure.xml" />
    <!-- 游戏库 DB 整体排除：WAL 未合并进主文件的云备份快照会静默丢失增量且令修复导入
         失效（countGames>0 即跳过）；DB 可由 prefs 镜像 + 启动修复完整重建，恢复后
         首次启动自动从 game_scanner/tyranor_game_overrides 镜像重导入（迁移方案第十节） -->
    <exclude domain="database" path="game_library.db" />
    <exclude domain="database" path="game_library.db-wal" />
    <exclude domain="database" path="game_library.db-shm" />
    <!-- 引擎原生插件与运行库是随 APK 分发的可重建解压副本（插件约 100 MB + 运行库约 144 MB），不参与备份 -->
    <exclude domain="file" path="engine_plugins/" />
    <exclude domain="file" path="engine_runtime/" />
</full-backup-content>
